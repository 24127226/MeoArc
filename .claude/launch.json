{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "be",
      "runtimeExecutable": "src/backend/.venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "uvicorn", "app.api.app:app", "--port", "8000", "--app-dir", "src/backend"],
      "port": 8000
    },
    {
      "name": "fe",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "src/frontend", "run", "dev", "--", "--port", "5180", "--strictPort"],
      "port": 5180
    },
    {
      "name": "fe-mock",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix", "src/frontend", "run", "dev", "--",
        "--mode", "mock", "--port", "5199", "--strictPort"
      ],
      "port": 5199
    }
  ]
}
