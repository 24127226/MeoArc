# MeoArc Backend — biến môi trường (MẪU).
# Cách dùng: copy file này thành `.env` rồi điền giá trị THẬT.
# LƯU Ý: file `.env` chứa BÍ MẬT → KHÔNG commit lên Git (đã có trong .gitignore).

# Lấy 2 giá trị này từ Google Cloud Console (xem hướng dẫn trong chat):
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Phải KHỚP y hệt "Authorized redirect URI" bạn khai trong Google Cloud:
GOOGLE_REDIRECT_URI=

# Frontend (để redirect về sau khi đăng nhập xong):
FRONTEND_URL=

# Phiên đăng nhập sống bao lâu (giờ):
SESSION_TTL_HOURS=

# Database Local
DATABASE_URL=

# Agent LLM (Gemini)
AI_API_KEY=
MODEL_NAME=
MODEL_PROVIDER=
LOCAL_MODEL_BASE_URL=

# Gỡ chặn theo vùng — CHỈ cần cho bản triển khai, để trống khi chạy máy nhà.
# Google chặn Gemini theo vị trí MÁY CHỦ GỌI; Azure "East Asia" = Hong Kong là vùng
# bị chặn. Đặt AI_BASE_URL bằng URL Cloudflare Worker (dựng theo
# infra/cf-gemini-proxy/README.md) để lời gọi đi ra từ Bắc Mỹ. KHÔNG có gạch chéo cuối.
AI_BASE_URL=
AI_PROXY_SECRET=

# Model DU PHONG khi model chinh het han muc, cach nhau dau phay.
# Han muc Gemini free tinh RIENG TUNG MODEL — do that 29/08/2026:
#   gemini-2.5-flash-lite = 20 luot/NGAY (khoang 10-15 luot chat)
#   gemini-2.5-flash      = con nguyen han muc rieng
# Xau chuoi thi tong han muc cong don, va buoi trinh bay khong chet giua chung.
MODEL_FALLBACKS=gemini-3.6-flash

# ── Tra cuu chuyen bay (Giai doan 2) ──
# Chon nguon theo khoa dang co: Amadeus -> AeroDataBox -> MO PHONG.
# DE TRONG CA HAI thi dung nha cung cap MO PHONG: chay duoc ngay, ket qua tat dinh, va
# moi ket qua mang nhan nguon "mo_phong" de khong ai nham gia gia thanh gia that.

# AeroDataBox qua RapidAPI — LICH BAY THAT (hang that, so hieu that, gio that, loai may
# bay, nha ga). KHONG co gia ve vi nguon nay khong ban ve: cot gia se hien "—".
# Lay khoa: rapidapi.com -> tim "AeroDataBox" -> Subscribe -> goi Basic ($0)
#           -> copy X-RapidAPI-Key.
# Luu y han muc: moi lan tim = 2 luot goi (API chan khoang thoi gian qua 12 tieng).
AERODATABOX_KEY=

# Amadeus Self-Service, moi truong TEST. DA DONG dang ky self-service — giu lai cho ai
# con khoa cu. Co khoa nay thi no duoc uu tien vi la nguon THAT va CO gia.
AMADEUS_KEY=
AMADEUS_SECRET=

TOKEN_ENCRYPTION_KEY=