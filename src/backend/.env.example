# MeoArc Backend — biến môi trường (MẪU).
# Cách dùng: copy file này thành `.env` rồi điền giá trị THẬT.
# LƯU Ý: file `.env` chứa BÍ MẬT → KHÔNG commit lên Git (đã có trong .gitignore).

# Lấy 2 giá trị này từ Google Cloud Console (xem hướng dẫn trong chat):
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Phải KHỚP y hệt "Authorized redirect URI" bạn khai trong Google Cloud:
GOOGLE_REDIRECT_URI=

# Frontend (để redirect về sau khi đăng nhập xong):
FRONTEND_URL=

# Phiên đăng nhập sống bao lâu (giờ):
SESSION_TTL_HOURS=

# Database Local
DATABASE_URL=

# Agent LLM (Gemini)
AI_API_KEY=
MODEL_NAME=
MODEL_PROVIDER=
LOCAL_MODEL_BASE_URL=

TOKEN_ENCRYPTION_KEY=