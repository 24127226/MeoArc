# ══════════════ MeoArc Backend — mẫu cấu hình (.env) ══════════════
# Copy thành .env rồi điền. Dòng nào ĐỂ TRỐNG = dùng mặc định an toàn.

# ── Google OAuth (bắt buộc để đăng nhập) — Google Cloud Console ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# ── Database ──
# Postgres (khuyên dùng): postgresql+psycopg://USER:PASS@localhost:5432/meoarc
# Để trống = SQLite file (máy chưa cài Postgres vẫn chạy được)
DATABASE_URL=

# Phiên đăng nhập sống bao lâu (giờ)
SESSION_TTL_HOURS=24

# ── Agent LLM (Gemini) — cần cho chat AI in-app; MCP KHÔNG cần ──
AI_API_KEY=
MODEL_NAME=gemini-2.5-flash-lite
MODEL_PROVIDER=google_genai
LOCAL_MODEL_BASE_URL=

# ── NFR-Security: mã hoá token Gmail trong DB (khuyên bật) ──
# Sinh khoá: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# ── NFR: ngưỡng bảo vệ tài nguyên ──
AGENT_RATE_LIMIT_PER_MIN=8
UPLOAD_MAX_MB=15

# ── Scale-out (tuỳ chọn): cache + rate-limit chạy trên Redis ──
# Đặt (vd redis://localhost:6379/0) khi chạy nhiều worker; trống = in-memory
REDIS_URL=

# ── Observability (tuỳ chọn): LangSmith tracing vòng agent ──
# Key free tại smith.langchain.com — điền là bật; trống = tắt (email không rời máy)
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=meoarc
